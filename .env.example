# ---- สภาพแวดล้อม ----
YII_ENV=prod
YII_DEBUG=false
APP_URL=https://booking.example.ac.th
COOKIE_VALIDATION_KEY=change-me-to-a-long-random-string

# ---- MySQL ----
DB_DSN=mysql:host=127.0.0.1;dbname=hall1500
DB_USER=hall
DB_PASS=secret

# ---- LINE Login (LINE Developers > Provider > LINE Login channel) ----
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
# ใส่ Callback URL ใน LINE console ให้ตรงกับ: {APP_URL}/auth/line-callback
# ชวนเพิ่มเพื่อน LINE OA ตอน login (normal | aggressive | ว่าง)
LINE_BOT_PROMPT=

# ---- LINE Messaging API (ไม่บังคับ: ส่งข้อความยืนยันการจอง) ----
LINE_MESSAGING_TOKEN=

# ---- ชำระเงิน ----
# PromptPay ของหน่วยงาน (เบอร์มือถือ 10 หลัก หรือเลขประจำตัวผู้เสียภาษี 13 หลัก)
PROMPTPAY_ID=0812345678
PROMPTPAY_NAME=มหาวิทยาลัยวลัยลักษณ์
# Omise (ไม่บังคับ: ถ้าใส่ key จะเปิดช่องทางจ่ายผ่าน Omise และยืนยันอัตโนมัติ)
OMISE_PUBLIC_KEY=
OMISE_SECRET_KEY=

# เปิดปุ่มล็อกอินทดสอบ (ห้ามเปิดบน production)
DEV_LOGIN=false
